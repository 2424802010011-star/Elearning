PORT=3000
DATABASE_URL=postgres://eduboard:eduboard@localhost:5432/eduboard
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Tạo tài khoản admin đầu tiên khi khởi động (nếu chưa có admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Chỉ dùng cho môi trường dev/test: tự tạo bảng theo entity
DB_SYNC=true
