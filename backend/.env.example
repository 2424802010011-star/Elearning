# Không cần file .env để chạy thử: thiếu DATABASE_URL thì tự dùng SQLite + dữ liệu mẫu.

PORT=3000

# --- Môi trường thật: dùng PostgreSQL ---
# DATABASE_URL=postgres://eduboard:eduboard@localhost:5432/eduboard
# Bảng được tạo/cập nhật bằng migration, tự chạy khi máy chủ khởi động.
# DB_MIGRATE=false        # tắt tự chạy migration (khi muốn chạy tay: npm run migration:run)
# DB_SYNC=true            # chỉ thử nghiệm nhanh: tự sửa bảng theo entity, có thể mất dữ liệu
# JWT_SECRET=chuoi-ngau-nhien-that-dai
# ADMIN_EMAIL=admin@truong.edu.vn
# ADMIN_PASSWORD=doi-mat-khau-nay

# --- Chạy thử bằng SQLite ---
# SQLITE_FILE=eduboard-demo.sqlite
# SEED_DEMO=true

# --- Họp trực tuyến (LiveKit). Mặc định khớp với "livekit-server --dev" ---
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# --- File tải lên (bài giảng, bài nộp) ---
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=50
