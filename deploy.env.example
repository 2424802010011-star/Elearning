# Chép file này thành .env (cùng thư mục với docker-compose.yml) rồi sửa các giá trị.

# Bắt buộc
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai
ADMIN_EMAIL=admin@truong.edu.vn
ADMIN_PASSWORD=doi-mat-khau-nay
POSTGRES_PASSWORD=doi-mat-khau-csdl

# Cổng web của EduBoard
APP_PORT=3000

# Họp video (LiveKit). Khóa và bí mật tự đặt, giống nhau ở cả hai phía.
LIVEKIT_API_KEY=eduboard
LIVEKIT_API_SECRET=doi-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu
# Địa chỉ trình duyệt dùng để vào phòng họp:
#   trong mạng LAN:  ws://<IP máy chủ>:7880
#   có HTTPS:        wss://<LIVEKIT_DOMAIN>
LIVEKIT_URL=ws://localhost:7880
# Máy chủ có IP công cộng (thuê cloud) thì đặt true
LIVEKIT_USE_EXTERNAL_IP=false

# HTTPS (docker compose --profile https up -d)
# DOMAIN=eduboard.truong.edu.vn
# LIVEKIT_DOMAIN=video.truong.edu.vn

# Tùy chọn
MAX_UPLOAD_MB=50
REMIND_MINUTES=15
